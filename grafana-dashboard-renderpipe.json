{
 "title": "xmxmon \u2014 RenderPipeProfile",
 "uid": "xmxmon-renderpipe",
 "timezone": "",
 "refresh": "5s",
 "schemaVersion": 39,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {},
    "hide": 0
   },
   {
    "name": "device",
    "label": "GPU device",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "query": {
     "query": "label_values(xmxmon_gauge, device)",
     "refId": "StandardVariableQuery"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1,
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "title": "At a glance",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "title": "GPU busy",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"GPU_BUSY\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       },
       {
        "color": "green",
        "value": 40
       },
       {
        "color": "orange",
        "value": 90
       }
      ]
     }
    }
   }
  },
  {
