{
 "title": "xmxmon \u2014 XvePipelineRasterizationProfile",
 "uid": "xmxmon-xve-raster",
 "timezone": "",
 "refresh": "5s",
 "schemaVersion": 39,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {},
    "hide": 0
   },
   {
    "name": "device",
    "label": "GPU device",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "query": {
     "query": "label_values(xmxmon_gauge, device)",
     "refId": "StandardVariableQuery"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1,
    "hide": 0
   }
  ]
 },
