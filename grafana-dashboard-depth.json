     "legendFormat": "EARLY_DEPTH_STENCIL_TEST_FAIL_NP"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"EARLY_DEPTH_STENCIL_TEST_FAIL_P\", device=~\"$device\"}",
     "legendFormat": "EARLY_DEPTH_STENCIL_TEST_FAIL_P"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"HIZ_DEPTH_TEST_AMBIG_NP\", device=~\"$device\"}",
     "legendFormat": "HIZ_DEPTH_TEST_AMBIG_NP"
    },
    {
     "refId": "H",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"HIZ_DEPTH_TEST_AMBIG_P\", device=~\"$device\"}",
     "legendFormat": "HIZ_DEPTH_TEST_AMBIG_P"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "cps",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   }
  },
