    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"IZ_SUBSPAN_LATENCY_FIFOFULL\", device=~\"$device\"}",
