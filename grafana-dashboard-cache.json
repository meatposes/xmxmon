    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"L3_BUSY\", device=~\"$device\"}",
