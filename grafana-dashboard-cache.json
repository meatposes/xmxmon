  },
  {
   "title": "L3 superq full",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"L3_SUPERQ_FULL\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     }
    }
   }
  },
  {
   "title": "L3 behaviour",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "title": "L3 accesses",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"L3_HIT\", device=~\"$device\"}",
     "legendFormat": "hit"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"L3_MISS\", device=~\"$device\"}",
     "legendFormat": "miss"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"L3_READ\", device=~\"$device\"}",
     "legendFormat": "read"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"L3_WRITE\", device=~\"$device\"}",
     "legendFormat": "write"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "cps",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "description": "Misses here become the VRAM traffic in the bottom row."
  },
