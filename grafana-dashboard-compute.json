{
 "title": "xmxmon \u2014 ComputeBasic",
 "uid": "xmxmon-compute",
 "timezone": "",
 "refresh": "5s",
 "schemaVersion": 39,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {},
    "hide": 0
   },
   {
    "name": "device",
    "label": "GPU device",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "query": {
     "query": "label_values(xmxmon_gauge, device)",
     "refId": "StandardVariableQuery"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1,
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "title": "At a glance",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "title": "GPU busy",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"GPU_BUSY\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       },
       {
        "color": "green",
        "value": 40
       },
       {
        "color": "orange",
        "value": 90
       }
      ]
     }
    }
   }
  },
  {
   "title": "XVE active",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"XVE_ACTIVE\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       },
       {
        "color": "green",
        "value": 40
       },
       {
        "color": "orange",
        "value": 90
       }
      ]
     }
    }
   }
  },
  {
   "title": "VRAM read BW",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_rate_per_s{metric=\"GPU_MEMORY_BYTE_READ\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   }
  },
  {
   "title": "Dispatch overhead",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"GPGPU_DISPATCH\", device=~\"$device\"}",
     "legendFormat": "dev{{device}}"
    }
   ],
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     }
    }
   }
  },
  {
   "title": "Compute",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "title": "Utilization %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"GPU_BUSY\", device=~\"$device\"}",
     "legendFormat": "GPU busy"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"XVE_ACTIVE\", device=~\"$device\"}",
     "legendFormat": "XVE active"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"XVE_THREADS_OCCUPANCY_ALL\", device=~\"$device\"}",
     "legendFormat": "occupancy"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"XVE_STALL\", device=~\"$device\"}",
     "legendFormat": "XVE stall"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "xmxmon_gauge{metric=\"GPGPU_DISPATCH\", device=~\"$device\"}",
     "legendFormat": "dispatch"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     },
     "max": 100
    },
    "overrides": []
   },
   "description": "XVE stall rising while busy stays high = the XVEs are fed but waiting on memory."
  },
  {
   "title": "Cache hit rates %",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
